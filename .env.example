# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"



# Optional AI Providers for Multi-Provider Routing & Fallbacks:
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# Optional External Data & Tool APIs:
CURSEFORGE_API_KEY=""
SERPER_API_KEY=""

# Discord Webhook URL for Contact Form (optional — submissions logged to console if not set):
DISCORD_WEBHOOK_URL=""

# Optional Upstash Redis for Agent Long-Term Memory (Fallback to In-Memory store if not provided):
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


